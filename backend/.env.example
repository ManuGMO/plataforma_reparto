# Ejemplo de variables de entorno para backend
DB_NAME=plataforma
DB_USER=root
DB_PASSWORD=secret
DB_HOST=localhost
DB_DIALECT=mysql
BACK_PORT=3001
DB_PORT=3306

# Mapbox / ORS keys si se usan en el servidor
ORS_API_KEY=
MAPBOX_TOKEN=

# Umbral en metros para considerar un pedido cercano a la ruta del repartidor
ROUTE_MAX_DISTANCE_METERS=1000
